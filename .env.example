# Öffentliche Adresse (so wie sie im Browser steht)
PUBLIC_URL=https://einkauf.example.org

# Langer Zufallswert, z. B. `openssl rand -base64 48`.
# Verschlüsselt gespeicherte Secrets (Mealie-Token) – nach dem Start nicht mehr ändern.
SECRET_KEY=

POSTGRES_PASSWORD=

# Wird in docker-compose.yml gesetzt; für die lokale Entwicklung selbst angeben:
# DATABASE_URL=postgres://postgres@127.0.0.1:5432/shopping

# Pocket ID: OIDC-Client "Shopping" anlegen,
#   Callback-URL: ${PUBLIC_URL}/auth/callback, PKCE aktiv,
#   Zugriff über "Allowed User Groups" steuern.
OIDC_ISSUER=https://id.example.org
OIDC_CLIENT_ID=
# Leer lassen bei einem öffentlichen Client (PKCE)
OIDC_CLIENT_SECRET=
OIDC_ADMIN_GROUP=admins
# Beschriftung des Anmeldeknopfs
OIDC_LOGIN_LABEL=Mit Pocket ID anmelden
# Haushalte: Claim mit dem Haushalts-Tag (in Pocket ID: Custom Claim am Benutzer oder an einer Gruppe).
# Wer keinen Tag hat, ist im Standard-Haushalt; dessen Name:
OIDC_HOUSEHOLD_CLAIM=household
DEFAULT_HOUSEHOLD_NAME=Haushalt

# Nur für die lokale Entwicklung: Anmeldung nur mit Namen
# DEV_LOGIN=true
